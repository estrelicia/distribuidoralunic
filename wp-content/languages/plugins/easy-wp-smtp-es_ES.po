#: assets/languages/easy-wp-smtp-vue.php:474
msgid "%1$sFollow this link%2$s to get a Sender Name for SMTP.com."
msgstr "%1$sSigue este enlace%2$s para conseguir un nombre de remitente de SMTP.com."

